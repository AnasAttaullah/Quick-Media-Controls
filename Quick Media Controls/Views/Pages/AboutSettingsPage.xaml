<Page
    x:Class="Quick_Media_Controls.Views.Pages.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Quick_Media_Controls.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About Settings Page"
    mc:Ignorable="d">

    <StackPanel Margin="20,15,20,0" VerticalAlignment="Center">

        <StackPanel
            Margin="4,0,4,10"
            HorizontalAlignment="Center"
            Orientation="Vertical">
            <ui:Image
                Width="120"
                Height="120"
                Margin="0,0,0,10"
                Source="/Assets/logo.png" />
            <ui:TextBlock
                FontSize="24"
                FontTypography="Subtitle"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                Text="Quick Media Controls" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
            <ui:TextBlock
                Margin="4,0,4,14"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                Opacity="0.85"
                Text="A Windows tray app that lets you control media playback quickly"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Grid Width="220" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="Author:" />
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="License:" />
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="Framework:" />
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="Platform:" />
                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="Version:" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <ui:TextBlock
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="Anas Attaullah" />
                    <ui:TextBlock
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="GNU GPL v3.0" />
                    <ui:TextBlock
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text=".NET 8" />
                    <ui:TextBlock
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="Windows 10 / 11" />
                    <ui:TextBlock
                        FontTypography="Body"
                        Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                        Text="{Binding AppVersion}" />
                </StackPanel>
            </Grid>

        </StackPanel>

    </StackPanel>
</Page>
